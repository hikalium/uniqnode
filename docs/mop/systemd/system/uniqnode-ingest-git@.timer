# uniqnode-ingest-git@<インスタンス>.service を毎時起こす timer。置き場は /etc/systemd/system/。
# 読み方と置き方は docs/mop/SYSTEMD.md(uuid:7de68e4a-e6a6-4930-8cc7-a56f90f522e2)の
# 「git の木を定期に取り込む」。インスタンス名は取り込み先のコレクション名(既定)。

[Unit]
Description=Hourly uniqnode ingest-git [%i]

[Timer]
# 毎時 0 分(ローカル)。変わらない文書は no-op なので、刻みを細かくしても増えるのは
# 変わった文書の版だけである。刻みを変えるなら drop-in の OnCalendar= で。
OnCalendar=hourly
# 機械が止まっていて刻みを逃したら、次の起動時に 1 回走らせる。
Persistent=true

[Install]
WantedBy=timers.target
