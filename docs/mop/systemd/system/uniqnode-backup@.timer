# uniqnode-backup@<インスタンス>.service を毎日起こす timer。置き場は /etc/systemd/system/。
# 読み方と手順は docs/mop/SYSTEMD.md(uuid:7de68e4a-e6a6-4930-8cc7-a56f90f522e2)。
# user 単位(~/.config/systemd/user/)には ../user/ の同名ファイルを使う(中身は同じ)。
# テンプレート unit である。`@` の後がインスタンス名で、同じ機械に何組でも置ける
# (uniqnode-serve@default.service、uniqnode-serve@graph.service)。unit の中の %i が
# その名に置き換わり、既定のストアも写し先もインスタンスごとに分かれる。名を決めるのは
# `uniqnode install <dir> --instance <名>` で、省くと default になる。

[Unit]
Description=Daily uniqnode backup [%i]

[Timer]
# 毎日 0 時(ローカル)。刻みを変えるなら drop-in の OnCalendar= で(`systemd-analyze calendar`
# で次の発火時刻を確かめられる)。
OnCalendar=daily
# 機械が止まっていて刻みを逃したら、次の起動時に 1 回走らせる。
Persistent=true

[Install]
WantedBy=timers.target
