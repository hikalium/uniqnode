# uniqnode-backup.service を毎日起こす timer。置き場は ~/.config/systemd/user/。
# 読み方と手順は docs/mop/SYSTEMD.md(uuid:7de68e4a-e6a6-4930-8cc7-a56f90f522e2)。
# ../system/ の同名ファイルと中身は同じ(timer に User= や閉じ込めは無い)。

[Unit]
Description=Daily uniqnode backup

[Timer]
# 毎日 0 時(ローカル)。刻みを変えるなら drop-in の OnCalendar= で(`systemd-analyze calendar`
# で次の発火時刻を確かめられる)。
OnCalendar=daily
# 機械が止まっていて刻みを逃したら、次の起動時に 1 回走らせる。user 単位のマネージャは
# ログアウトで止まるので、`loginctl enable-linger` が無いと刻みそのものが来ない。
Persistent=true

[Install]
WantedBy=timers.target
