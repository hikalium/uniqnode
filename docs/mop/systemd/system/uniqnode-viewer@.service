# uniqnode viewer を system 単位で常駐させる unit。置き場は /etc/systemd/system/。
# 読み方と手順は docs/mop/SYSTEMD.md(uuid:7de68e4a-e6a6-4930-8cc7-a56f90f522e2)。
# user 単位(~/.config/systemd/user/)には ../user/ の同名ファイルを使う。
# テンプレート unit である。`@` の後がインスタンス名で、同じ機械に何組でも置ける
# (uniqnode-serve@default.service、uniqnode-serve@graph.service)。unit の中の %i が
# その名に置き換わり、既定のストアも写し先もインスタンスごとに分かれる。名を決めるのは
# `uniqnode install <dir> --instance <名>` で、省くと default になる。

[Unit]
Description=uniqnode viewer (RAG viewer, one HTML page forwarding to serve) [%i]
# serve の後に起こす。Requires= にしないのは、serve が居なくても頁は出て、届かないことを
# 502 の本文で言うため(serve を起こし直したら、そのまま繋がる)。
After=network.target uniqnode-serve@%i.service
Wants=uniqnode-serve@%i.service

[Service]
Type=exec
#   UNIQNODE_DATA_DIR        serve と同じストア。開かない(ロックを取らない)が、届かないときの
#                            案内とログの置き場(<dir>/logs/viewer.log)に使う。
#   UNIQNODE_VIEWER_LISTEN   ブラウザが開く待ち受け(README と同じ 7450)。
#   UNIQNODE_SERVE_URL       転送先。serve の UNIQNODE_LISTEN を変えたらここも変える。
#   UNIQNODE_VIEWER_OPTIONS  追加の引数(ログの指定など)。空なら引数 0 個に消える。
Environment=UNIQNODE_DATA_DIR=%S/uniqnode/%i
Environment=UNIQNODE_VIEWER_LISTEN=127.0.0.1:7450
Environment=UNIQNODE_SERVE_URL=http://127.0.0.1:7440
Environment=UNIQNODE_VIEWER_OPTIONS=
ExecStart=/usr/local/bin/uniqnode viewer ${UNIQNODE_DATA_DIR} ${UNIQNODE_VIEWER_LISTEN} --serve-url ${UNIQNODE_SERVE_URL} $UNIQNODE_VIEWER_OPTIONS

User=uniqnode
Group=uniqnode
# serve と同じディレクトリを共有する(書くのは logs/viewer.log だけ)。
StateDirectory=uniqnode/%i
StateDirectoryMode=0750

# serve と同じ方針。viewer はロックを取らないので、起こし直しに条件はない。
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=1 2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
