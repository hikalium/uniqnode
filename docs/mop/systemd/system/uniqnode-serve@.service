# uniqnode serve を system 単位で常駐させる unit。置き場は /etc/systemd/system/。
# 読み方と手順は docs/mop/SYSTEMD.md(uuid:7de68e4a-e6a6-4930-8cc7-a56f90f522e2)。
# user 単位(~/.config/systemd/user/)には ../user/ の同名ファイルを使う。
# テンプレート unit である。`@` の後がインスタンス名で、同じ機械に何組でも置ける
# (uniqnode-serve@default.service、uniqnode-serve@graph.service)。unit の中の %i が
# その名に置き換わり、既定のストアも写し先もインスタンスごとに分かれる。名を決めるのは
# `uniqnode install <dir> --instance <名>` で、省くと default になる。

[Unit]
Description=uniqnode serve (knowledge store HTTP API) [%i]
After=network.target

[Service]
Type=exec
# 運用者が変えるものはすべて環境変数にしてある。変えるときはこのファイルを編集せず
# `systemctl edit uniqnode-serve@<インスタンス>` の drop-in に Environment= を書く。
#   UNIQNODE_DATA_DIR       ストアのデータディレクトリ。既定は下の StateDirectory。
#   UNIQNODE_LISTEN         HTTP API の待ち受け(README と同じ 7440)。
#   UNIQNODE_SERVE_OPTIONS  追加の引数(空白で分ける)。既定は空で、serve は他のプロセスに
#                           依存しない。埋め込みを装備するなら drop-in に例えば
#                           Environment="UNIQNODE_SERVE_OPTIONS=--embed http://127.0.0.1:8083/v1/embeddings"
# UNIQNODE_SERVE_OPTIONS だけ ${} で囲まないのは、空のときに引数 0 個に消えるため
# (${} で囲むと空文字列 1 個の引数になり、usage で落ちる)。
Environment=UNIQNODE_DATA_DIR=%S/uniqnode/%i
Environment=UNIQNODE_LISTEN=127.0.0.1:7440
Environment=UNIQNODE_SERVE_OPTIONS=
ExecStart=/usr/local/bin/uniqnode serve ${UNIQNODE_DATA_DIR} ${UNIQNODE_LISTEN} $UNIQNODE_SERVE_OPTIONS

User=uniqnode
Group=uniqnode
# /var/lib/uniqnode を作り、User= の所有にする。ストアのロック・ログ(logs/)・導出データ
# (derived/)はすべてこの下に書かれる。node_key を他の利用者に読ませないので 0750。
StateDirectory=uniqnode/%i
StateDirectoryMode=0750

# 落ちたら起こし直す。ストアのロックは抽象名前空間の unix socket なので、プロセスが死ねば
# カーネルが解放し、次の起動は書き込み途中で裂かれていても fsck なしで回復する
# (node/tests/crash.rs)。起動時に分かる誤りは再起動で直らないので、1 回で止めて理由を
# journal に残す: 1 はアドレスが塞がっている・別プロセスがストアを開いている、2 は引数の誤り。
# POST /v1/admin/shutdown による終了(0)は意図した停止なので起こし直さない。
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=1 2

# 閉じ込め。書けるのは StateDirectory の下だけになる。ストアのロックが unix socket なので
# AF_UNIX を残す。PrivateNetwork= は使わない(ロックはネットワーク名前空間ごとに別になり、
# 外の CLI と二重起動を検出し合えなくなる。viewer と mcp も loopback で serve に届く必要がある)。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
